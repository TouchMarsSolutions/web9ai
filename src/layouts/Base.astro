---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { SafeWidgetArea } from "@web9/blocks/astro";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import WebMcpSearch from "emdash/ui/webmcp-search";
import { Font } from "astro:assets";
import LanguageMenu from "../components/LanguageMenu.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { activeMenuHref, homeLanguages, linkRel, localizeHref, splitMenu } from "../../packages/web9-site/lib/nav.mjs";
import { uiLabels } from "../../packages/web9-site/lib/ui-labels.mjs";
import { LIMITS, clampText } from "../../packages/web9-blocks/lib/limits.mjs";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/global.css";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Doc pages: the doc's section and a slug -> section map of the docs the page loaded, for the active menu item */
	docNav?: { section: string; sectionOf: Record<string, string> };
	/** Language menu links (DocsPage passes the doc's translations); other pages link each locale's home page */
	languages?: { code: string; label: string; href: string }[];
}

const { title, pageTitle, description, image, canonical, robots, type = "website", publishedTime, modifiedTime, author, content, docNav, languages } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([getSiteSettingsWithCacheHint(), getMenuWithCacheHint("primary")]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(settingsResult.data);
const titleIncludesSiteName = title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const locale = Astro.currentLocale ?? "en";
const localePrefix = locale === "en" ? "" : `/${locale}`;
const labels = uiLabels(locale);
// One en menu; on zh-CN pages links that have a zh-CN route get the prefix (spec §5). The menu is on every page and
// has no hook, so the render keeps it bounded too: at most LIMITS.menuItems items, labels cut to LIMITS.label.
const menuItems = (menuResult.data?.items ?? [])
	.slice(0, LIMITS.menuItems)
	.map((item) => ({ ...item, label: clampText(item.label, LIMITS.label), href: localizeHref(item.url, locale) }));
const homeHref = localizeHref("/", locale);
// Header (spec 2026-10-17 docs UX §3.1): site links on the left with the current section highlighted, external links on
// the right; below 64rem (Tailwind's lg) they all move into the drawer (§3.3).
const activeHref = activeMenuHref(menuItems, Astro.url.pathname, docNav);
// nav.mjs is untyped JS, so splitMenu's result is `any`: give it the menu item type
const { internal: siteLinks, external: externalLinks }: { internal: typeof menuItems; external: typeof menuItems } = splitMenu(menuItems);
const languageLinks = languages ?? homeLanguages();

// Build public page context for plugin contributions; SEO data is rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
	// Absolute URLs in head (hreflang alternates) use the canonical origin, never the request Host
	siteUrl: Astro.site?.origin,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Apply an explicit theme choice before first paint. With no cookie the OS preference decides
			// (global.css: @media (prefers-color-scheme: dark) :root:not(.light)).
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") document.documentElement.classList.add(theme);
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header h-(--nav-height) border-b border-border-subtle">
			<nav class="mx-auto flex h-full max-w-[1400px] items-center gap-6 px-4 sm:px-6" aria-label={labels.main}>
				<button
					type="button"
					class="-ms-2 flex size-10 cursor-pointer items-center justify-center rounded text-text hover:bg-surface lg:hidden"
					aria-label={labels.menu}
					aria-haspopup="dialog"
					aria-expanded="false"
					aria-controls="site:drawer"
					data-drawer-open
				>
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M3 6h18M3 12h18M3 18h18"></path>
					</svg>
				</button>
				<a href={homeHref} class="flex shrink-0 items-center gap-2 text-lg font-semibold tracking-tight text-text hover:text-brand">
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="block h-8 w-auto" />
						) : (
							<Fragment>
								<img src="/img/logo-64.png" alt="" width="32" height="32" class="block size-8" />
								{siteTitle}
							</Fragment>
						)
					}
				</a>
				<div class="hidden items-center gap-5 lg:flex">
					{
						siteLinks.map((item) => (
							<a
								class="font-medium text-text hover:text-brand aria-[current=page]:text-brand"
								href={item.href} target={item.target} rel={linkRel(item.target)}
								aria-current={activeHref && item.href === activeHref ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</div>
				<div class="ms-auto hidden items-center gap-4 lg:flex">
					<LiveSearch
						placeholder="Search..."
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["docs", "posts", "pages"]}
						routeMap={{ docs: `${localePrefix}/docs/:slug` }}
					/>
					<LanguageMenu languages={languageLinks} locale={locale} />
					{
						externalLinks.map((item) => (
							<a class="flex items-center gap-1 text-sm text-text hover:text-brand" href={item.href} target={item.target} rel={linkRel(item.target)}>
								{item.label}
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"></path>
								</svg>
							</a>
						))
					}
					<ThemeToggle />
					{isLoggedIn && <a href="/_emdash/admin" class="text-sm text-text-secondary hover:text-text">Admin</a>}
				</div>
			</nav>
		</header>
		<dialog id="site:drawer" class="site-drawer" aria-label={labels.menu}>
			<div class="flex h-(--nav-height) shrink-0 items-center justify-between border-b border-border-subtle px-4">
				<a href={homeHref} class="flex items-center gap-2 font-semibold tracking-tight text-text">
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="block h-7 w-auto" />
						) : (
							<Fragment>
								<img src="/img/logo-64.png" alt="" width="28" height="28" class="block size-7" />
								{siteTitle}
							</Fragment>
						)
					}
				</a>
				<button
					type="button"
					class="flex size-9 cursor-pointer items-center justify-center rounded text-text-secondary hover:bg-surface hover:text-text"
					aria-label={labels.closeMenu}
					data-drawer-close
					autofocus
				>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M18 6 6 18M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-4 py-4">
				<LiveSearch
					placeholder="Search..."
					class="site-search drawer-search"
					inputClass="site-search-input"
					resultsClass="site-search-results"
					resultClass="site-search-result"
					collections={["docs", "posts", "pages"]}
					routeMap={{ docs: `${localePrefix}/docs/:slug` }}
				/>
				<ul class="m-0 list-none space-y-0.5 p-0">
					{
						menuItems.map((item) => (
							<li>
								<a
									class="block rounded px-2 py-1.5 font-medium text-text hover:bg-surface aria-[current=page]:bg-surface aria-[current=page]:text-brand"
									href={item.href} target={item.target} rel={linkRel(item.target)}
									aria-current={activeHref && item.href === activeHref ? "page" : undefined}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
				<div class="flex items-center justify-between gap-4 border-y border-border-subtle py-2">
					<LanguageMenu languages={languageLinks} locale={locale} variant="list" />
					<ThemeToggle />
				</div>
				<slot name="drawer" />
				{isLoggedIn && <a href="/_emdash/admin" class="block text-sm text-text-secondary hover:text-text">Admin</a>}
			</div>
		</dialog>
		<WebMcpSearch collections={["docs", "posts", "pages"]} routeMap={{ docs: `${localePrefix}/docs/:slug` }} />

		<main class="site-main">
			<slot />
		</main>

		<footer class="border-t border-border-subtle bg-bg-subtle">
			<div class="mx-auto max-w-[1400px] px-6 pt-16 pb-8">
				<div class="mb-12 grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-12 lg:grid-cols-[2fr_1fr_1fr_1fr]">
					<div class="max-w-[280px] sm:col-span-2 lg:col-span-1">
						<a href={homeHref} class="text-lg font-semibold tracking-tight text-text">
							{siteLogo ? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="h-6 w-auto" /> : siteTitle}
						</a>
						<p class="mt-3 text-sm text-muted">{siteTagline}</p>
					</div>
					<div>
						<h2 class="mb-4 text-xs font-medium tracking-wider text-text-secondary uppercase">Navigate</h2>
						<ul class="space-y-2 text-sm">
							{
								menuItems.map((item) => (
									<li>
										<a class="text-text-secondary hover:text-text" href={item.href} target={item.target} rel={linkRel(item.target)}>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
					<div>
						<h2 class="mb-4 text-xs font-medium tracking-wider text-text-secondary uppercase">Connect</h2>
						<ul class="space-y-2 text-sm">
							<li><a class="text-text-secondary hover:text-text" href="/rss.xml">RSS Feed</a></li>
						</ul>
					</div>
					<div class="text-sm text-text-secondary">
						<SafeWidgetArea name="footer" />
					</div>
				</div>
				<div class="border-t border-border pt-6 text-center sm:text-left">
					<p class="text-sm text-muted">Powered by <a class="text-text-secondary" href="https://emdashcms.com">EmDash</a></p>
				</div>
			</div>
		</footer>

		<script>
			// Theme: html.light / html.dark plus a `theme` cookie; "system" removes both. Every [data-theme-toggle]
			// (header and drawer) cycles light -> dark -> system; ThemeToggle.astro shows the icon from the html class.
			// The button's label is in the page's language (html lang, the locale Base renders).
			import { themeLabel } from "../../packages/web9-site/lib/ui-labels.mjs";

			const THEMES = ["light", "dark", "system"] as const;
			type Theme = (typeof THEMES)[number];
			const root = document.documentElement;
			const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
			const nextTheme = (theme: Theme) => THEMES[(THEMES.indexOf(theme) + 1) % THEMES.length];

			function setCookie(name: string, value: string, maxAge: number = 31536000) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				document.cookie =
					value === ""
						? `${name}=; path=/; max-age=0; SameSite=Lax${secure}`
						: `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
			}

			function setTheme(theme: Theme) {
				root.classList.remove("light", "dark");
				if (theme === "system") setCookie("theme", "");
				else {
					setCookie("theme", theme);
					root.classList.add(theme);
				}
				toggles.forEach((btn) => {
					btn.dataset.current = theme;
					btn.setAttribute("aria-label", themeLabel(root.lang, theme, nextTheme(theme)));
				});
			}

			// Same whitelist as the head script: any other cookie value counts as "system" (and is cleared).
			const stored = document.cookie.split("; ").find((item) => item.startsWith("theme="))?.slice(6);
			setTheme(stored === "light" || stored === "dark" ? stored : "system");
			toggles.forEach((btn) =>
				btn.addEventListener("click", () => setTheme(nextTheme(THEMES.find((t) => t === btn.dataset.current) ?? "system"))),
			);

			// Drawer below 64rem (the spec's 1024 px; spec 2026-10-17 docs UX §3.3): a modal <dialog>, so the browser traps focus, makes the
			// page inert and closes it on Esc. Its id has a colon, which github-slugger strips: no heading id can equal it.
			const drawer = document.getElementById("site:drawer") as HTMLDialogElement | null;
			const drawerOpen = document.querySelector<HTMLButtonElement>("[data-drawer-open]");
			function openDrawer() {
				if (!drawer || drawer.open) return;
				drawer.showModal();
				drawerOpen?.setAttribute("aria-expanded", "true");
			}
			drawerOpen?.addEventListener("click", openDrawer);
			drawer?.addEventListener("close", () => {
				drawerOpen?.setAttribute("aria-expanded", "false");
				// Focus goes back to the menu button only while it shows: past the breakpoint it is display:none
				if (drawerOpen && drawerOpen.offsetParent !== null) drawerOpen.focus();
			});
			drawer?.querySelector("[data-drawer-close]")?.addEventListener("click", () => drawer?.close());
			// A press on the backdrop reaches the dialog element itself, outside its box. Only a press that starts on the
			// backdrop and a click that ends there close the drawer, so a text-selection drag from inside the drawer to
			// outside it does not.
			function onBackdrop(e: MouseEvent) {
				if (!drawer || e.target !== drawer) return false;
				const box = drawer.getBoundingClientRect();
				return e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom;
			}
			let pressedBackdrop = false;
			drawer?.addEventListener("pointerdown", (e) => {
				pressedBackdrop = onBackdrop(e);
			});
			drawer?.addEventListener("click", (e) => {
				if (pressedBackdrop && onBackdrop(e)) drawer.close();
				pressedBackdrop = false;
			});
			// Widening the window to Tailwind's lg (64rem, the unit the ☰ button's lg:hidden uses) hides the menu button;
			// the drawer closes with it
			matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
				if (e.matches && drawer?.open) drawer.close();
			});

			// An open dropdown (LanguageMenu's <details data-dropdown>) closes on a click outside it, and on Esc, which
			// puts focus back on its <summary>
			document.addEventListener("click", (e) => {
				document.querySelectorAll<HTMLDetailsElement>("details[data-dropdown][open]").forEach((d) => {
					if (!d.contains(e.target as Node)) d.open = false;
				});
			});
			document.addEventListener("keydown", (e) => {
				if (e.key !== "Escape") return;
				document.querySelectorAll<HTMLDetailsElement>("details[data-dropdown][open]").forEach((d) => {
					// focus returns to the summary only when it was inside this dropdown, not when Esc was pressed elsewhere
					const focusWasInside = d.contains(document.activeElement);
					d.open = false;
					if (focusWasInside) d.querySelector("summary")?.focus();
				});
			});

			// ⌘K / Ctrl+K focuses the visible search box; below 64rem it opens the drawer first
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const visible = [...document.querySelectorAll<HTMLInputElement>(".site-search-input")].find((el) => el.offsetParent !== null);
					if (visible) return visible.focus();
					openDrawer();
					drawer?.querySelector<HTMLInputElement>(".site-search-input")?.focus();
				}
			});
		</script>

		<style>
			/*
			 * Chrome that needs stacking or viewport units stays in scoped CSS: public utilities must never
			 * position, stack or size anything against the viewport (spec §10, scripts/check-public-css.mjs).
			 */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: color-mix(in srgb, var(--color-bg) 65%, transparent);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}
			.site-main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}

			/* LiveSearch renders its own markup; these class names are passed to it as props. */
			.site-search {
				position: relative;
				width: 180px;
				--emdash-search-border-focus: var(--color-brand);
			}
			:global(.site-search-input) {
				width: 180px;
				padding: 0.5rem 0.75rem;
				font-family: var(--font-body);
				font-size: 0.875rem;
				border: 1px solid var(--color-border);
				border-radius: 4px;
				background: var(--color-bg);
				color: var(--color-text);
				transition:
					border-color 120ms ease,
					box-shadow 120ms ease;
			}
			:global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}
			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-brand) !important;
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}
			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: 0.5rem;
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: 8px;
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}
			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: 1rem;
				text-align: center;
				color: var(--color-muted);
				font-size: 0.875rem;
			}
			:global(.site-search-result) {
				display: block;
				padding: 0.75rem 1rem;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background 120ms ease;
			}
			:global(.site-search-result):last-child {
				border-bottom: none;
			}
			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}
			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 500;
				font-size: 0.875rem;
			}
			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: 0.8125rem;
				color: var(--color-text-secondary);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				margin-top: 2px;
			}
			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: 0.875rem;
				color: var(--color-muted);
				margin-top: 0.25rem;
				line-height: 1.3;
			}
			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
			}
			/* The drawer's search box spans the drawer. LiveSearch's root carries LiveSearch's scope attribute, not this
			   file's, so a scoped selector would not reach it: :global. */
			:global(.drawer-search),
			:global(.drawer-search .site-search-input) {
				width: 100%;
			}

			/*
			 * The drawer is a modal <dialog>: the browser puts it in the top layer, so it needs no position or z-index
			 * of its own (check-public-css rejects position:fixed), and its viewport sizes stay here, out of utility classes.
			 * Its head row is a flex child that does not scroll; the content under it is the scroller (overflow-y-auto).
			 * Keeping the row out of the scrolled box means the positioned bits inside the content (LiveSearch's relative
			 * root, the sidebar's sticky items) can never paint over it, which a sticky row would need a z-index to stop.
			 */
			.site-drawer {
				width: min(20rem, 85vw);
				max-width: none;
				height: 100dvh;
				max-height: none;
				margin: 0;
				padding: 0;
				border: 0;
				border-inline-end: 1px solid var(--color-border);
				background: var(--color-bg);
				color: var(--color-text);
				overflow: hidden;
			}
			.site-drawer::backdrop {
				background: rgb(0 0 0 / 0.45);
			}
			.site-drawer[open] {
				display: flex;
				flex-direction: column;
				animation: drawer-in 180ms ease-out;
			}
			@keyframes drawer-in {
				from {
					transform: translateX(-100%);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.site-drawer[open] {
					animation: none;
				}
			}
			/* The page behind an open drawer does not scroll */
			:global(html:has(.site-drawer[open])) {
				overflow: hidden;
			}
		</style>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
