---
import { getEmDashCollection, getTranslations } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

interface Props {
	doc: any;
	locale: string;
	fallbackLocale?: string;
}
const { doc, locale, fallbackLocale } = Astro.props;
const prefix = locale === "en" ? "" : `/${locale}`;

// Sidebar: every doc in this locale, grouped section -> category, ordered by sort_order
const { entries } = await getEmDashCollection("docs", { locale, limit: 500 });
const groups = new Map<string, typeof entries>();
for (const e of [...entries].sort((a, b) => (a.data.sort_order ?? 0) - (b.data.sort_order ?? 0))) {
	const key = `${e.data.section ?? "ai"} / ${e.data.category ?? "general"}`;
	groups.set(key, [...(groups.get(key) ?? []), e]);
}

const translations = (await getTranslations("docs", doc.data.id)).translations?.filter(
	(t) => t.status === "published",
) ?? [];
---

<Base title={doc.data.title} description={doc.data.description} content={{ collection: "docs", id: doc.data.id, slug: doc.data.slug }}>
	<div class="docs">
		<nav class="docs-nav" aria-label="Docs">
			{
				[...groups].map(([group, items]) => (
					<div class="docs-nav__group">
						<p class="docs-nav__label">{group}</p>
						<ul>
							{items.map((e) => (
								<li>
									<a href={`${prefix}/docs/${e.data.slug}`} aria-current={e.data.slug === doc.data.slug ? "page" : undefined}>
										{e.data.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
		<article class="docs-body">
			{fallbackLocale && <p class="docs-fallback">This page is not translated yet; showing {fallbackLocale}.</p>}
			{
				translations.length > 1 && (
					<p class="docs-langs">
						{translations.map((t) => (
							<a href={`${t.locale === "en" ? "" : `/${t.locale}`}/docs/${t.slug}`} aria-current={t.locale === locale ? "true" : undefined}>
								{t.locale}
							</a>
						))}
					</p>
				)
			}
			<h1 {...doc.edit.title}>{doc.data.title}</h1>
			{doc.data.description && <p class="docs-desc">{doc.data.description}</p>}
			<div {...doc.edit.body}>
				<PortableText value={doc.data.body} />
			</div>
		</article>
	</div>
</Base>

<style>
	.docs { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 2.5rem; max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
	.docs-nav { position: sticky; top: 1rem; align-self: start; font-size: 0.92rem; }
	.docs-nav__label { text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; opacity: 0.6; margin: 1rem 0 0.35rem; }
	.docs-nav ul { list-style: none; padding: 0; margin: 0; }
	.docs-nav a { display: block; padding: 0.25rem 0; color: inherit; text-decoration: none; opacity: 0.8; }
	.docs-nav a[aria-current="page"] { opacity: 1; font-weight: 600; }
	.docs-desc { opacity: 0.75; }
	.docs-fallback { padding: 0.5rem 0.75rem; border-radius: 6px; background: color-mix(in srgb, #d9a400 15%, transparent); }
	.docs-langs { display: flex; gap: 0.75rem; font-size: 0.9rem; }
	.docs-langs a[aria-current="true"] { font-weight: 700; }
	@media (max-width: 760px) {
		.docs { grid-template-columns: 1fr; }
		.docs-nav { position: static; }
	}
</style>
