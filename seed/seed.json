{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Web9.AI",
		"description": "Web9.AI knowledge base (docs), blog and landing pages",
		"author": "EmDash"
	},
	"settings": {
		"title": "Web9.AI",
		"tagline": "square of web3 to the power of AI",
		"url": "https://www.web9.ai"
	},
	"blockTypes": [
		{
			"slug": "hero",
			"label": "Hero",
			"description": "Page header: title, tagline, optional image and up to two buttons",
			"category": "Web9",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "title",
							"label": "Title",
							"type": "string",
							"required": true
						},
						{
							"slug": "tagline",
							"label": "Tagline",
							"type": "text"
						},
						{
							"slug": "image",
							"label": "Image",
							"type": "image"
						},
						{
							"slug": "primary_label",
							"label": "Primary button label",
							"type": "string"
						},
						{
							"slug": "primary_href",
							"label": "Primary button link",
							"type": "url"
						},
						{
							"slug": "secondary_label",
							"label": "Secondary button label",
							"type": "string"
						},
						{
							"slug": "secondary_href",
							"label": "Secondary button link",
							"type": "url"
						}
					]
				}
			]
		},
		{
			"slug": "feature_grid",
			"label": "Feature grid",
			"description": "Row of features: title + description + image",
			"category": "Web9",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "title",
							"label": "Section title (optional)",
							"type": "string"
						},
						{
							"slug": "features",
							"label": "Features",
							"type": "repeater",
							"validation": {
								"minItems": 1,
								"maxItems": 12,
								"subFields": [
									{
										"slug": "title",
										"label": "Title",
										"type": "string",
										"required": true
									},
									{
										"slug": "description",
										"label": "Description",
										"type": "text"
									},
									{
										"slug": "image",
										"label": "Image",
										"type": "image"
									}
								]
							}
						}
					]
				}
			]
		}
	],
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/posts/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"scheduling",
				"search",
				"seo"
			],
			"commentsEnabled": true,
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				},
				{
					"slug": "search_text",
					"label": "Search text (auto-generated, do not edit)",
					"type": "text",
					"searchable": true
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/pages/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "search_text",
					"label": "Search text (auto-generated, do not edit)",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "layout",
					"label": "Layout",
					"type": "blocks",
					"validation": {
						"allowedTypes": [
							"hero",
							"feature_grid"
						]
					}
				}
			]
		},
		{
			"slug": "docs",
			"label": "Docs",
			"labelSingular": "Doc",
			"description": "Knowledge base docs (AI / Dev)",
			"urlPattern": "/docs/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text"
				},
				{
					"slug": "section",
					"label": "Section",
					"type": "select",
					"required": true,
					"translatable": false,
					"validation": {
						"options": [
							"ai",
							"dev"
						]
					}
				},
				{
					"slug": "category",
					"label": "Category",
					"type": "string"
				},
				{
					"slug": "sort_order",
					"label": "Sort order",
					"type": "integer",
					"indexed": true,
					"translatable": false
				},
				{
					"slug": "body",
					"label": "Body",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "search_text",
					"label": "Search text (auto-generated, do not edit)",
					"type": "text",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": [
				"posts"
			],
			"terms": []
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": [
				"posts"
			],
			"terms": [
				{
					"slug": "ai",
					"label": "AI"
				},
				{
					"slug": "course",
					"label": "course"
				},
				{
					"slug": "workshop",
					"label": "workshop"
				},
				{
					"slug": "tools",
					"label": "tools"
				},
				{
					"slug": "tiny-course",
					"label": "tiny-course"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Blog",
					"url": "/posts"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Widget area displayed on single post pages",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories"
				},
				{
					"type": "component",
					"componentId": "core:tags",
					"title": "Tags"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"props": {
						"count": 5,
						"showDate": true
					}
				},
				{
					"type": "component",
					"componentId": "core:archives",
					"title": "Archives",
					"props": {
						"type": "monthly",
						"limit": 6
					}
				}
			]
		},
		{
			"name": "footer",
			"label": "Footer",
			"description": "Widget area displayed in the site footer",
			"widgets": []
		}
	]
}
